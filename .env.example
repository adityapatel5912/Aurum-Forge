# FORGE — free-tier LLM keys (copy to .env and fill in)
# Chain per role: Groq -> Nvidia -> Gemini -> OpenRouter (logs/llm_cache.json)

# Groq: planner gpt-oss-120b, executor llama-3.1-8b-instant
GROQ_API_KEY=

# Nvidia NIM: codegen poolside/laguna-xs-2.1, planner fallback nemotron-3-ultra-550b
NVIDIA_API_KEY=

# Gemini: vision gemini-3.7-flash, executor fallback flash-lite (either name works)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OpenRouter: last-resort free models
OPENROUTER_API_KEY=
