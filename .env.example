# ==============================================================================
# FORGE-AURUM SUPER-HUB — SECRETS CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your real API keys and credentials.
# Note: Non-secret configurations and runtime flags have sane defaults in backend/config.py.

# 1. Notion Secret Token
NOTION_TOKEN=secret_your_notion_api_token_here

# 2. Gmail / Email Secret App Password (16-char code)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. Slack Bot Secret Token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# 4. GitHub Personal Access Secret Token
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# 5. YouTube Data API Secret Key
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key_here

# 6. LLM Provider Secret Keys (Optional for live LLM reasoning/codegen)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
