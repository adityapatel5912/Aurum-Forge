# ==============================================================================
# FORGE-AURUM SUPER-HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Add your real API keys and credentials below for live external dispatch.
# Note: When keys are empty, FORGE-AURUM operates in Zero-LLM Deterministic Mode (<2.1s offline).

# ------------------------------------------------------------------------------
# 1. NOTION INTEGRATION (Notion MCP, Research Chain, Content Chain, Ops Chain)
# ------------------------------------------------------------------------------
# Get your Internal Integration Token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_api_token_here
NOTION_API_KEY=secret_your_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
NOTION_PARENT_PAGE=your_notion_parent_page_id_here

# ------------------------------------------------------------------------------
# 2. GMAIL / EMAIL INTEGRATION (Gmail MCP, Research Chain, Ops Chain, Sales Chain)
# ------------------------------------------------------------------------------
# Use your Gmail address and a Google App Password (16-character code):
# Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_TO=recipient_email@example.com

# ------------------------------------------------------------------------------
# 3. SLACK INTEGRATION (Slack MCP, Content Chain, Dev Lead Chain)
# ------------------------------------------------------------------------------
# Create Slack App & Webhook / Bot Token: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL_HERE

# ------------------------------------------------------------------------------
# 4. GITHUB INTEGRATION (GitHub MCP, Research Chain, Dev Lead Chain)
# ------------------------------------------------------------------------------
# Generate Personal Access Token (Classic or Fine-grained): https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS INTEGRATION (Sheets MCP, Ops Chain, Sales Chain)
# ------------------------------------------------------------------------------
# Google Cloud Service Account JSON credentials or Sheet ID:
SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-project"}

# ------------------------------------------------------------------------------
# 6. YOUTUBE INTEGRATION (YouTube MCP, Content Chain)
# ------------------------------------------------------------------------------
# YouTube Data API v3 Key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key_here

# ------------------------------------------------------------------------------
# 7. LLM PROVIDER KEYS (Optional for dynamic AI codegen fallback)
# ------------------------------------------------------------------------------
# Free-tier provider endpoints (Groq / Gemini / Nvidia / OpenRouter)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 8. FORGE RUNTIME FLAGS
# ------------------------------------------------------------------------------
FORGE_HEADFUL=1
FORGE_HEADLESS=0
