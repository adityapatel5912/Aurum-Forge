{
  "claude_code": {
    "platform_id": "claude_code",
    "platform": "Claude Code",
    "is_cli": true,
    "command": "claude mcp add forge-registry -- python D:/Aditya/Forge/forge/mcp/forge_registry_mcp/server.py",
    "config_file": "claude_desktop_config.json",
    "config_path": "%APPDATA%/Claude/claude_desktop_config.json",
    "config": {
      "mcpServers": {
        "forge-registry": {
          "command": "python",
          "args": [
            "D:/Aditya/Forge/forge/mcp/forge_registry_mcp/server.py"
          ],
          "env": {
            "NOTION_TOKEN": "<your_notion_token>",
            "NOTION_DATABASE_ID": "<optional_notion_database_id>",
            "GMAIL_USER": "<your_gmail_address>",
            "GMAIL_APP_PASSWORD": "<your_gmail_app_password>",
            "GMAIL_TO": "<where_to_send_alerts>",
            "FORGE_HEADLESS": "0"
          }
        }
      }
    },
    "instructions": "Run `claude mcp add forge-registry -- python D:/Aditya/Forge/forge/mcp/forge_registry_mcp/server.py` in your terminal."
  },
